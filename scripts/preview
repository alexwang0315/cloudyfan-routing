#!/bin/sh
set -eu
MONITOR_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
CORE_ROOT=${CLOUDYFAN_CORE_ROOT:-"$MONITOR_ROOT/../cloudyfan-mrc"}
export PYTHONDONTWRITEBYTECODE=1
export PYTHONPATH="$MONITOR_ROOT/src:$CORE_ROOT/src"
exec "$CORE_ROOT/.venv/bin/python" -m cloudyfan_monitor --demo --core-root "$CORE_ROOT" --data "$MONITOR_ROOT/runtime/local-integration" "$@"
